# ==============================================================================
# CertPulse Environment Configuration
# ==============================================================================
# All integrations are completely optional for local development & evaluation.
# CertPulse includes built-in sandboxed fallback engines for outbox logging,
# client-side Tesseract OCR, simulated card generation, and local file storage.
# ==============================================================================

# Private Cloud Storage (Vercel Blob)
# Leave empty for local development to use local file storage (.data/) or in-memory storage.
BLOB_READ_WRITE_TOKEN=

# Vercel Cron Secret (protects POST /api/cron/sweep)
CRON_SECRET=

# Twilio SMS / MMS Integration
# If omitted, notifications are logged to the in-app sandbox outbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Resend Email Integration
# If omitted, notification emails are logged to the in-app sandbox outbox.
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@certpulse.app

# Optional AI Vision OCR Enhancement
# If omitted, CertPulse extracts dates using in-browser & server regex/pattern OCR.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=

# Optional Stripe Integration
# If omitted, CertPulse operates in self-serve test-card mode with instant activation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
